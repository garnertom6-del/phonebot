// Moore Divine Care Smart Intake - Prisma schema.
// Production uses SQLite on the Render service's persistent disk.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  sessionVersion Int            @default(0) // increment on password reset to revoke older sessions
  name         String
  role         String           @default("staff") // master | admin | staff | reviewer
  createdAt    DateTime         @default(now())
  auditLogs    AuditLog[]
  memberships  UserMembership[]
  assignedSupportReferrals SupportReferral[] @relation("SupportReferralAssignee")
  supportReferralEvents SupportReferralEvent[] @relation("SupportReferralActor")
}

model Provider {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  contactName String?
  email       String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  UserMembership[]
  clients      Client[]
  intakes      Intake[]
  auditLogs    AuditLog[]
  pdfTemplates PdfTemplate[]
  messageDeliveries MessageDelivery[]
  directoryStewardship DirectoryStewardship[]
  supportReferrals SupportReferral[]
  supportReferralEvents SupportReferralEvent[]
  ncTracksConfiguration NcTracksConfiguration?
  ncTracksHost NcTracksHost?
  ncTracksJobs NcTracksJob[]
}

// Append-only directory ownership and review history; no intake/client data.
model DirectoryStewardship {
  id               Int      @id @default(autoincrement())
  providerId       String
  directoryVersion String
  action           String   // ASSIGN | REVIEW
  ownerUserId      String
  ownerName        String
  actorUserId      String
  actorName        String
  note             String   @default("")
  createdAt        DateTime @default(now())
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, directoryVersion, id])
}

model UserMembership {
  id         String   @id @default(uuid())
  userId     String
  providerId String
  role       String   @default("STAFF") // PROVIDER_ADMIN | STAFF | REVIEWER
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([providerId])
}

model Client {
  id            String    @id @default(uuid())
  providerId    String?
  provider      Provider? @relation(fields: [providerId], references: [id])
  fullName      String
  dob           String
  midNumber     String?
  recordNumber  String?
  email         String?
  phone         String?
  guardianName  String?
  guardianEmail String?
  guardianPhone String?
  createdAt     DateTime  @default(now())
  intakes       Intake[]

  @@index([providerId])
  @@unique([providerId, recordNumber], name: "provider_record_number")
}

model Intake {
  id                 String    @id @default(uuid())
  providerId         String?
  provider           Provider? @relation(fields: [providerId], references: [id])
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id])
  packageName        String    @default("Client Intake Package")
  status             String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SUBMITTED | NEEDS_REVIEW | SIGNED | COMPLETED
  mode               String    @default("full") // fast | full
  expectCca          Boolean   @default(true) // short client intake; clinician CCA fills the rest
  archived           Boolean   @default(false) // hidden from the dashboard list
  docusignEnvelopeId String? // set when a DocuSign envelope is sent
  token              String    @unique
  tokenExpiresAt     DateTime
  copyToken          String?   @unique
  copyTokenExpiresAt DateTime?
  intakeDate         String?
  location           String?
  linkSentAt         DateTime?
  lastActivityAt     DateTime?
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  contentRevision    Int       @default(1) // material answer/client/CCA changes; signatures bind to this revision
  workflowOwnerUserId String?
  abandonedAt        DateTime?
  workflowIntervals  WorkflowInterval[]
  ncTracksJobs       NcTracksJob[]

  answers           IntakeAnswer[]
  sections          IntakeSection[]
  signatures        Signature[]
  generatedPdfs     GeneratedPdf[]
  documentReviews   DocumentReview[]
  auditLogs         AuditLog[]
  uploadedDocuments UploadedDocument[]
  releaseConsents   ReleaseConsent[]
  referrals         Referral[]
  emergencyContacts EmergencyContact[]
  medications       Medication[]
  substanceUseRows  SubstanceUseRow[]
  treatmentPlanRows TreatmentPlanSignatureRow[]
  followUps         IntakeFollowUp[]
  messageDeliveries MessageDelivery[]
  supportReferrals SupportReferral[]
  supportReferralEvents SupportReferralEvent[]

  @@index([providerId])
}

model IntakeFollowUp {
  id             String    @id @default(uuid())
  intakeId       String
  intake         Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  token          String    @unique
  fieldKeys      String // JSON string[] of client-answerable question keys
  status         String    @default("OPEN") // OPEN | PROCESSING | COMPLETED | SUPERSEDED
  tokenExpiresAt DateTime
  recipientRole  String    @default("client") // client | guardian
  sentAt         DateTime?
  completedAt    DateTime?
  attestedAt     DateTime?
  skippedKeys    String? // JSON string[] of requested items deferred back to staff
  savedCount     Int       @default(0)
  attestationJson String?
  attestationSha256 String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([intakeId, status])
}

model IntakeAnswer {
  id        String   @id @default(uuid())
  intakeId  String
  intake    Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  key       String
  value     String // JSON-encoded value (string | string[] | boolean | number)
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([intakeId, key])
  @@index([intakeId])
}

model IntakeSection {
  id          String    @id @default(uuid())
  intakeId    String
  intake      Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  sectionKey  String
  status      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([intakeId, sectionKey])
}

model Signature {
  id           String   @id @default(uuid())
  intakeId     String
  intake       Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  role         String // client | guardian | staff | clinician | witness | medicalDirector
  imageData    String // PNG data URL from the signature canvas
  printedName  String
  relationship String? // client | parent | guardian | legalRepresentative
  signedDate   String
  dobVerified  Boolean  @default(false) // signer confirmed the client's DOB
  contentRevision Int? // intake content revision this signature approved
  subjectNameSnapshot String? // client/guardian identity bound at capture time
  subjectDobSnapshot  String? // client DOB bound at capture time
  signerUserId String? // authenticated staff user for staff-side signatures
  invalidatedAt DateTime?
  invalidatedReason String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([intakeId, role])
}

model PdfTemplate {
  id               String            @id @default(uuid())
  name             String            @unique
  filePath         String
  pageCount        Int
  pageWidth        Float?
  pageHeight       Float?
  providerId       String?
  provider         Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  originalFileName String?
  isActive         Boolean           @default(true)
  mappingStatus    String            @default("APPROVED") // DRAFT | APPROVED
  mappingScore     Int?
  mappingIssues    String?
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  fieldMappings    PdfFieldMapping[]

  @@index([providerId, isActive])
}

// Admin mapping-screen overrides; merged over src/config/mooreDivinePacketMap.json
model PdfFieldMapping {
  id         String      @id @default(uuid())
  templateId String
  template   PdfTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey   String
  page       Int
  data       String // JSON: {source,type,x,y,width,height,fontSize,lines,required,role,consentKey,notes,deleted?}
  updatedAt  DateTime    @updatedAt

  @@unique([templateId, fieldKey])
}

model GeneratedPdf {
  id        String   @id @default(uuid())
  intakeId  String
  intake    Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  filePath  String
  sha256    String? // fingerprint of the packet pages (certificate page excluded)
  packetVersion Int @default(1)
  contentRevision Int @default(1)
  createdAt DateTime @default(now())

  @@unique([intakeId, packetVersion])
}

// Immutable review copies; never replace the generated/signed packet.
model DocumentReview {
  id String @id @default(uuid())
  intakeId String
  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  source String // DRAFT | GENERATED
  sourcePacketId String?
  packetVersion Int?
  contentRevision Int
  filePath String
  sha256 String // complete review file fingerprint
  pageCount Int
  fillWarningCount Int @default(0)
  createdByUserId String
  createdByName String
  createdAt DateTime @default(now())
  corrections DocumentCorrection[]
  @@index([intakeId, createdAt])
}

model DocumentCorrection {
  id String @id @default(uuid())
  reviewId String
  review DocumentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  page Int
  comment String
  assignedUserId String
  assignedName String
  createdByUserId String
  createdByName String
  status String @default("OPEN") // OPEN | RESOLVED
  resolutionNote String?
  resolvedByName String?
  resolvedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([reviewId, status])
}

model MessageDelivery {
  id           String    @id @default(uuid())
  messageSid   String?   @unique
  intakeId     String?
  intake       Intake?   @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  providerId   String?
  provider     Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  channel      String    @default("sms")
  purpose      String
  recipient    String // masked destination hint only; never the full phone number
  status       String    @default("pending")
  errorCode    String?
  errorMessage String?
  isFinal      Boolean   @default(false)
  deliveredAt  DateTime?
  finalAt      DateTime?
  lastStatusAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([intakeId, purpose, createdAt])
  @@index([providerId, createdAt])
}

model AuditLog {
  id         String    @id @default(uuid())
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  intakeId   String?
  intake     Intake?   @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  event      String // intake_created | link_opened | section_started | section_completed | signature_captured | packet_submitted | staff_reviewed | pdf_generated | pdf_downloaded | ...
  detail     String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([intakeId])
  @@index([providerId])
}

model UploadedDocument {
  id        String   @id @default(uuid())
  intakeId  String
  intake    Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  docType   String // birth_certificate | insurance_card | court_order | ss_card | iep_records | medication_list | pcp_plan | immunization_records | standing_orders | other
  fileName  String
  filePath  String
  mimeType  String
  reviewJson String? // JSON: CcaReview from the AI document accuracy pass
  createdAt DateTime @default(now())

  @@index([intakeId])
}

model ReleaseConsent {
  id        String  @id @default(uuid())
  intakeId  String
  intake    Intake  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  slot      Int // 1..3 map to packet pages 19-21; >3 duplicates page template
  recipient String
  items     String // JSON string[]
  purpose   String?
  thruDate  String?
  agreed    Boolean @default(false)

  @@index([intakeId])
}

model Referral {
  id       String  @id @default(uuid())
  intakeId String
  intake   Intake  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  slot     Int
  name     String
  phone    String?

  @@index([intakeId])
}

model EmergencyContact {
  id        String  @id @default(uuid())
  intakeId  String
  intake    Intake  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  slot      Int // 1 or 2
  name      String
  street    String?
  city      String?
  state     String?
  homePhone String?
  workPhone String?
  cellPhone String?

  @@index([intakeId])
}

model Medication {
  id       String  @id @default(uuid())
  intakeId String
  intake   Intake  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  name     String
  dosage   String?
  kind     String  @default("prescription") // prescription | otc

  @@index([intakeId])
}

model SubstanceUseRow {
  id        String  @id @default(uuid())
  intakeId  String
  intake    Intake  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  slot      Int // 1..5
  name      String
  ageFirst  String?
  frequency String?
  route     String?
  amount    String?
  lastUsed  String?

  @@index([intakeId])
}

model TreatmentPlanSignatureRow {
  id         String  @id @default(uuid())
  intakeId   String
  intake     Intake  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  slot       Int
  staffDate  String?
  clientDate String?

  @@index([intakeId])
}

// Separate from packet Referral rows, which answer synchronization replaces.
model SupportReferral {
  id String @id @default(uuid())
  providerId String
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  intakeId String
  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  resourceId String
  resourceName String
  resourceUrl String
  category String
  status String @default("SUGGESTED")
  assignedUserId String?
  assignedUser User? @relation("SupportReferralAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  nextContactAt DateTime?
  permissionGrantedAt DateTime?
  permissionWithdrawnAt DateTime?
  permissionSource String?
  permissionRecordedByUserId String?
  contactedAt DateTime?
  confirmedAssistanceAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events SupportReferralEvent[]

  @@unique([intakeId, resourceId])
  @@index([providerId, status, nextContactAt])
  @@index([providerId, assignedUserId])
}

// Append-only through application APIs: changes always create another event.
model SupportReferralEvent {
  id String @id @default(uuid())
  providerId String
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  intakeId String
  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  referralId String
  referral SupportReferral @relation(fields: [referralId], references: [id], onDelete: Restrict)
  actorUserId String
  actorUser User @relation("SupportReferralActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  kind String
  fromStatus String?
  toStatus String
  revision Int
  detailsJson String
  occurredAt DateTime @default(now())

  @@unique([referralId, revision])
  @@index([providerId, occurredAt])
  @@index([intakeId, occurredAt])
}

// Observed workflow transitions. Historical durations are never invented.
model WorkflowInterval {
  id          String    @id @default(uuid())
  intakeId    String
  intake      Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  stage       String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  @@index([intakeId, startedAt])
}

// Outbound home-host bridge. Portal secrets and local artifact paths never enter this database.
model NcTracksConfiguration {
  providerId    String @id
  authorizedNpi String?
  updatedAt     DateTime @updatedAt
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model NcTracksHost {
  id             String @id @default(uuid())
  providerId     String @unique
  name           String
  credentialHash String @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime?
  adapterReady   Boolean @default(false)
  createdAt      DateTime @default(now())
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  jobs           NcTracksJob[]
}

model NcTracksJob {
  id                  String @id @default(uuid())
  providerId          String
  intakeId            String
  requestedByUserId   String
  idempotencyKey      String
  dedupKey            String
  identityFingerprint String
  subjectJson         String
  authorizedNpi       String
  serviceDateFrom     String
  serviceDateTo       String
  status              String @default("NOT_CONFIGURED")
  coverage            String @default("UNKNOWN")
  attempt             Int @default(0)
  hostId              String?
  leaseHash           String?
  leaseStartedAt      DateTime?
  leaseExpiresAt      DateTime?
  resultJson          String?
  code                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  provider            Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  intake              Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  host                NcTracksHost? @relation(fields: [hostId], references: [id], onDelete: SetNull)

  @@unique([providerId, idempotencyKey])
  @@index([providerId, dedupKey, status])
  @@index([hostId, status, leaseExpiresAt])
  @@index([intakeId])
}
